<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1,user-scalable=no">
<style>
body{margin:0;overflow:hidden;background:#0b0b0f;font-family:sans-serif;touch-action:none}
#ui{position:fixed;top:10px;left:10px;background:rgba(15,15,22,.88);padding:7px;border-radius:8px;border:1px solid #333;width:155px;z-index:9}
button{background:#242638;color:#fff;border:1px solid #444;padding:6px;margin:2px 0;border-radius:4px;width:100%;text-align:left;font-size:11px}
button.on{background:#d90429;font-weight:bold}
button.red{background:#800f2f}
</style>
</head>
<body>
<div id="ui">
<button id="b1" class="on" onclick="md=0;b1.className='on';b2.className=''">✋ Attraper 3D</button>
<button id="b2" onclick="md=1;b2.className='on';b1.className=''">🔫 Pistolet 3D</button>
<button onclick="rag()">🧍 Ragdoll</button>
<button onclick="pts.forEach(p=>{p.y-=280;p.oy=p.y})">⬆️ Hauteur</button>
<button onclick="bmb.push({x:0,y:-150,z:0,oy:-150})">💣 Bombe</button>
<button class="red" onclick="boom()">💥 EXPLOSER</button>
<button onclick="slw=!slw;this.innerText='⏱️ Ralenti: '+(slw?'OUI':'NON')">⏱️ Ralenti: NON</button>
<button onclick="pts=[];stk=[];bld=[];pls=[];bmb=[]">🧹 Nettoyer</button>
</div>
<canvas id="c"></canvas>
<script>
const c=document.getElementById('c'),x=c.getContext('2d');
let W=c.width=innerWidth,H=c.height=innerHeight,md=0,slw=0,pts=[],stk=[],bld=[],pls=[],bmb=[],fls=0,ang=.45,pit=.34,drg=0,rot=0,lx=0,ly=0;
onresize=()=>{W=c.width=innerWidth;H=c.height=innerHeight};
function prj(X,Y,Z){
  let ca=Math.cos(ang),sa=Math.sin(ang),rx=X*ca-Z*sa,rz=X*sa+Z*ca,cp=Math.cos(pit),sp=Math.sin(pit),ry=(Y+55)*cp-rz*sp,fz=(Y+55)*sp+rz*cp+630,sc=560/Math.max(90,fz);
  return{x:W/2+rx*sc,y:H/2+ry*sc,s:sc,z:fz};
}
function addB(X,Y,Z,n,v=5){
  for(let i=0;i<n;i++)bld.push({x:X,y:Y,z:Z,vx:(Math.random()-.5)*v*2,vy:-(Math.random()*v+2),vz:(Math.random()-.5)*v*2,r:Math.random()*2.5+1.2,l:180});
  if(bld.length>250)bld.splice(0,50);
}
function P(X,Y,Z,r=7,col='#f2cc8f'){let p={x:X,y:Y,z:Z,ox:X,oy:Y,oz:Z,r,col,bl:0};pts.push(p);return p}
function L(a,b,t=10,c1='#457b9d',c2='#1d3557',lim=55){stk.push({a,b,d:Math.hypot(b.x-a.x,b.y-a.y,b.z-a.z),t,c1,c2,lim,br:0})}
function rag(){
  let X=(Math.random()-.5)*60,Y=-190,Z=(Math.random()-.5)*60;
  let h=P(X,Y,Z,14),n=P(X,Y+20,Z,6),p=P(X,Y+62,Z,8,'#2b2d42'),le=P(X-20,Y+34,Z,6),lh=P(X-24,Y+58,Z+4,6),re=P(X+20,Y+34,Z,6),rh=P(X+24,Y+58,Z-4,6),lk=P(X-11,Y+92,Z+3,7,'#2b2d42'),lf=P(X-11,Y+122,Z+3,7,'#111'),rk=P(X+11,Y+92,Z-3,7,'#2b2d42'),rf=P(X+11,Y+122,Z-3,7,'#111');
  L(h,n,8,'#f2cc8f','#bc8a5f',34);L(n,p,21,'#457b9d','#1d3557',85);
  L(n,le,9,'#f2cc8f','#bc8a5f',44);L(le,lh,8,'#f2cc8f','#bc8a5f',42);
  L(n,re,9,'#f2cc8f','#bc8a5f',44);L(re,rh,8,'#f2cc8f','#bc8a5f',42);
  L(p,lk,11,'#3d405b','#1d1e2c',50);L(lk,lf,10,'#3d405b','#1d1e2c',48);
  L(p,rk,11,'#3d405b','#1d1e2c',50);L(rk,rf,10,'#3d405b','#1d1e2c',48);
}
function boom(){
  bmb.forEach(b=>{
    fls=12;addB(b.x,b.y,b.z,24,14);
    pts.forEach(p=>{let dx=p.x-b.x,dy=p.y-b.y,dz=p.z-b.z,d=Math.hypot(dx,dy,dz)||1;if(d<310){let f=(1-d/310)*44;p.ox-=(dx/d)*f;p.oy-=(dy/d)*f-14;p.oz-=(dz/d)*f;p.bl=110}});
    stk.forEach(s=>{if(Math.hypot(s.a.x-b.x,s.a.y-b.y,s.a.z-b.z)<145){s.br=1;s.c1='#800f2f'}});
  });bmb=[];
}
c.onpointerdown=e=>{
  lx=e.clientX;ly=e.clientY;
  if(md==0){let b=50;pts.forEach(p=>{let r=prj(p.x,p.y,p.z),d=Math.hypot(r.x-lx,r.y-ly);if(d<b){b=d;drg=p}});if(!drg)rot=1}
  else{let hit=0;pts.forEach(p=>{let r=prj(p.x,p.y,p.z);if(Math.hypot(r.x-lx,r.y-ly)<30){hit=1;p.ox-=(Math.random()-.5)*30;p.oy+=16;p.oz-=(Math.random()-.5)*30;p.bl=110;addB(p.x,p.y,p.z,18,8);stk.forEach(s=>{if((s.a==p||s.b==p)&&Math.random()>.35){s.br=1;s.c1='#800f2f'}})}});bmb.forEach(b=>{let r=prj(b.x,b.y,b.z);if(Math.hypot(r.x-lx,r.y-ly)<34){hit=1;boom()}});if(!hit)rot=1}
};
c.onpointermove=e=>{
  let dx=e.clientX-lx,dy=e.clientY-ly;lx=e.clientX;ly=e.clientY;
  if(drg){let ca=Math.cos(ang),sa=Math.sin(ang);drg.x+=dx*ca*1.1;drg.z-=dx*sa*1.1;drg.y+=dy*1.1;drg.ox=drg.x-dx*ca*.5;drg.oz=drg.z+dx*sa*.5;drg.oy=drg.y-dy*.5}
  else if(rot){ang+=dx*.008;pit=Math.max(.08,Math.min(1.15,pit+dy*.006))}
};
c.onpointerup=()=>{drg=0;rot=0};
function loop(){
  let g=slw?.12:.56,fy=140,bn=260;
  pts.forEach(p=>{
    if(p==drg)return;
    let vx=(p.x-p.ox)*.99,vy=(p.y-p.oy)*.99,vz=(p.z-p.oz)*.99;if(slw){vx*=.85;vy*=.85;vz*=.85}
    p.ox=p.x;p.oy=p.y;p.oz=p.z;p.x+=vx;p.y+=vy+g;p.z+=vz;
    if(p.y>fy-p.r){if(vy>13){addB(p.x,p.y,p.z,Math.min(25,vy*1.5|0),7);p.bl=100;p.col='#9b2226';pls.push({x:p.x,z:p.z,r:Math.min(26,vy*1.3)});if(pls.length>70)pls.shift()}p.y=fy-p.r;p.oy=p.y+vy*.2;p.ox=p.x-vx*.8;p.oz=p.z-vz*.8}
    if(p.x<-bn)p.x=-bn;if(p.x>bn)p.x=bn;if(p.z<-bn)p.z=-bn;if(p.z>bn)p.z=bn;
    if(p.bl>0){p.bl--;if(Math.random()<.35)addB(p.x,p.y,p.z,1,2)}
  });
  for(let k=0;k<4;k++)stk.forEach(s=>{if(s.br)return;let dx=s.b.x-s.a.x,dy=s.b.y-s.a.y,dz=s.b.z-s.a.z,d=Math.hypot(dx,dy,dz)||1;if(d>s.lim){s.br=1;s.c1='#800f2f';addB(s.a.x,s.a.y,s.a.z,16,8);return}let df=(s.d-d)/d*.5;if(s.a!=drg){s.a.x-=dx*df;s.a.y-=dy*df;s.a.z-=dz*df}if(s.b!=drg){s.b.x+=dx*df;s.b.y+=dy*df;s.b.z+=dz*df}});
  bmb.forEach(b=>{let vy=(b.y-b.oy)*.98;b.oy=b.y;b.y+=vy+g;if(b.y>fy-b.r){b.y=fy-b.r;b.oy=b.y+vy*.3}});
  bld.forEach(d=>{d.x+=d.vx;d.y+=d.vy;d.z+=d.vz;d.vy+=g*.6;d.l--;if(d.y>fy){if(Math.random()<.25){pls.push({x:d.x,z:d.z,r:4+Math.random()*5});if(pls.length>70)pls.shift()}d.l=0}});
  bld=bld.filter(d=>d.l>0);
  x.fillStyle=fls>0?'#3a1c1a':'#0b0b0f';if(fls>0)fls--;x.fillRect(0,0,W,H);
  let p1=prj(-bn,fy,-bn),p2=prj(bn,fy,-bn),p3=prj(bn,fy,bn),p4=prj(-bn,fy,bn);
  x.fillStyle='#16161f';x.beginPath();x.moveTo(p1.x,p1.y);x.lineTo(p2.x,p2.y);x.lineTo(p3.x,p3.y);x.lineTo(p4.x,p4.y);x.fill();
  x.strokeStyle='#252533';x.lineWidth=1.2;
  for(let i=-bn;i<=bn;i+=65){let a=prj(i,fy,-bn),b=prj(i,fy,bn),d=prj(-bn,fy,i),e=prj(bn,fy,i);x.beginPath();x.moveTo(a.x,a.y);x.lineTo(b.x,b.y);x.moveTo(d.x,d.y);x.lineTo(e.x,e.y);x.stroke()}
  x.fillStyle='#6b0504';pls.forEach(l=>{let r=prj(l.x,fy,l.z);x.beginPath();x.ellipse(r.x,r.y,l.r*r.s,l.r*r.s*.45,0,0,7);x.fill()});
  x.fillStyle='rgba(0,0,0,.45)';pts.forEach(p=>{let r=prj(p.x,fy,p.z);x.beginPath();x.ellipse(r.x,r.y,p.r*r.s*1.2,p.r*r.s*.5,0,0,7);x.fill()});
  let rl=[];
  stk.forEach(s=>{if(!s.br){let a=prj(s.a.x,s.a.y,s.a.z),b=prj(s.b.x,s.b.y,s.b.z);rl.push({z:(a.z+b.z)/2,t:0,a,b,w:s.t,c1:s.c1,c2:s.c2})}});
  pts.forEach(p=>{if(p.r>8){let r=prj(p.x,p.y,p.z);rl.push({z:r.z,t:1,r,R:p.r,c:p.col})}});
  bmb.forEach(b=>{let r=prj(b.x,b.y,b.z);rl.push({z:r.z,t:2,r,R:16})});
  bld.forEach(d=>{let r=prj(d.x,d.y,d.z);rl.push({z:r.z,t:3,r,R:d.r})});
  rl.sort((a,b)=>b.z-a.z);x.lineCap='round';
  rl.forEach(i=>{
    if(i.t==0){let w=Math.max(2,i.w*(i.a.s+i.b.s)/2);x.strokeStyle=i.c2;x.lineWidth=w+2;x.beginPath();x.moveTo(i.a.x,i.a.y);x.lineTo(i.b.x,i.b.y);x.stroke();x.strokeStyle=i.c1;x.lineWidth=w*.75;x.beginPath();x.moveTo(i.a.x,i.a.y);x.lineTo(i.b.x,i.b.y);x.stroke()}
    else if(i.t==1){let R=Math.max(2,i.R*i.r.s),g=x.createRadialGradient(i.r.x-R*.3,i.r.y-R*.3,R*.1,i.r.x,i.r.y,R);g.addColorStop(0,'#fff');g.addColorStop(.25,i.c);g.addColorStop(1,'#222');x.fillStyle=g;x.beginPath();x.arc(i.r.x,i.r.y,R,0,7);x.fill()}
    else if(i.t==2){let R=Math.max(3,16*i.r.s);x.fillStyle='#111';x.beginPath();x.arc(i.r.x,i.r.y,R,0,7);x.fill();x.strokeStyle='#ffba08';x.lineWidth=2;x.stroke()}
    else{x.fillStyle='#d90429';x.beginPath();x.arc(i.r.x,i.r.y,Math.max(1.5,i.R*i.r.s),0,7);x.fill()}
  });
  requestAnimationFrame(loop);
}
rag();loop();
</script>
</body>
</html>
